# PhishGuard Environment Configuration Template
# Copy this file to '.env' and fill in your values.
# Do NOT commit your actual '.env' file to version control.

# Flask secret key used for session signing and CSRF tokens.
# In production, this MUST be set to a secure, random 32-byte or 64-character hex string.
# Example command to generate one: python -c "import secrets; print(secrets.token_hex(32))"
PHISHGUARD_SECRET_KEY=your_secret_key_here

# Flask debug mode: 0 for disabled (recommended), 1 for enabled (local development only)
FLASK_DEBUG=0

# Session cookie security (0 = allow HTTP for local dev; 1 = require HTTPS in production)
SESSION_COOKIE_SECURE=0
